# Image manifest for offline mirroring. Every reference here resolves inside
# the bundle: archives are loaded into the local registry and pods pull from it.
# The upstream source registry is NOT recorded here; it is supplied to
# mirror-images.sh via $SOURCE_REGISTRY at staging time on a connected host.
localRegistry: {{ .LocalRegistry }}
images:
  - repository: {{ .Image.Repository }}
    tag: {{ .Image.Tag | quote }}
    archive: {{ .Image.Archive }}
    localRef: {{ .Image.LocalRef | quote }}
